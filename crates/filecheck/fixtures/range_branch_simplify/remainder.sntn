target = "evm-ethereum-osaka"

# sameln: func public %bounded_remainder(v0.i32) -> i32 {
# not: br v2
# check: jump block1;
func public %bounded_remainder(v0.i32) -> i32 {
block0:
    v1.i32 = umod v0 4.i32;
    v2.i1 = lt v1 4.i32;
    br v2 block1 block2;
block1:
    return v1;
block2:
    return 99.i32;
}

# sameln: func public %unknown_divisor(v0.i32, v1.i32) -> i32 {
# check: br v3 block1 block2;
func public %unknown_divisor(v0.i32, v1.i32) -> i32 {
block0:
    v2.i32 = umod v0 v1;
    v3.i1 = lt v2 4.i32;
    br v3 block1 block2;
block1:
    return v2;
block2:
    return 99.i32;
}

# sameln: func public %insufficient_bound(v0.i32) -> i32 {
# check: br v2 block1 block2;
func public %insufficient_bound(v0.i32) -> i32 {
block0:
    v1.i32 = umod v0 8.i32;
    v2.i1 = lt v1 4.i32;
    br v2 block1 block2;
block1:
    return v1;
block2:
    return 99.i32;
}

# EVM `mod` returns 0 for a zero divisor, so a divisor range that includes 0
# still bounds the remainder.
# sameln: func public %evm_remainder_maybe_zero_divisor(v0.i256, v1.i8) -> i256 {
# not: br v4
# check: jump block1;
func public %evm_remainder_maybe_zero_divisor(v0.i256, v1.i8) -> i256 {
block0:
    v2.i256 = zext v1 i256;
    v3.i256 = evm_umod v0 v2;
    v4.i1 = lt v3 255.i256;
    br v4 block1 block2;
block1:
    return v3;
block2:
    return 99.i256;
}

# sameln: func public %evm_remainder_insufficient_bound(v0.i256) -> i256 {
# check: br v2 block1 block2;
func public %evm_remainder_insufficient_bound(v0.i256) -> i256 {
block0:
    v1.i256 = evm_umod v0 8.i256;
    v2.i1 = lt v1 4.i256;
    br v2 block1 block2;
block1:
    return v1;
block2:
    return 99.i256;
}
