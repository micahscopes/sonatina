target = "evm-ethereum-osaka"

# sameln: func public %bounded_remainder(v0.i32) -> i32 {
# not: br v2
# check: jump block1;
func public %bounded_remainder(v0.i32) -> i32 {
block0:
    v1.i32 = umod v0 4.i32;
    v2.i1 = lt v1 4.i32;
    br v2 block1 block2;
block1:
    return v1;
block2:
    return 99.i32;
}

# sameln: func public %unknown_divisor(v0.i32, v1.i32) -> i32 {
# check: br v3 block1 block2;
func public %unknown_divisor(v0.i32, v1.i32) -> i32 {
block0:
    v2.i32 = umod v0 v1;
    v3.i1 = lt v2 4.i32;
    br v3 block1 block2;
block1:
    return v2;
block2:
    return 99.i32;
}

# sameln: func public %insufficient_bound(v0.i32) -> i32 {
# check: br v2 block1 block2;
func public %insufficient_bound(v0.i32) -> i32 {
block0:
    v1.i32 = umod v0 8.i32;
    v2.i1 = lt v1 4.i32;
    br v2 block1 block2;
block1:
    return v1;
block2:
    return 99.i32;
}
