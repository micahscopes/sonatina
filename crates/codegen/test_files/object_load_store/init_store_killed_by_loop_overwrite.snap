---
source: crates/codegen/tests/object_load_store.rs
input_file: test_files/object_load_store/init_store_killed_by_loop_overwrite.sntn
---
target = "evm-ethereum-osaka"

func private %f(v0.i256) -> objref<[i256; 3]> {
    block0:
        v1.objref<[i256; 3]> = obj.alloc [i256; 3];
        v2.objref<i256> = obj.index v1 0.i256;
        obj.store v2 v0;
        v3.objref<i256> = obj.index v1 1.i256;
        obj.store v3 v0;
        v4.objref<i256> = obj.index v1 2.i256;
        obj.store v4 v0;
        jump block1;

    block1:
        v5.i256 = phi (0.i256 block0) (v9 block2);
        v6.i1 = lt v5 3.i256;
        br v6 block2 block3;

    block2:
        v7.objref<i256> = obj.index v1 v5;
        obj.store v7 42.i256;
        v9.i256 = add v5 1.i256;
        jump block1;

    block3:
        return v1;
}
